meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{loginEmail}}",
    "password": "{{loginPassword}}"
  }
}

script:post-response {
  bru.setEnvVar("accessToken", res.body.accessToken);
  bru.setEnvVar("refreshToken", res.body.refreshToken);
}
