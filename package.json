{
  "name": "orderflow",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de gestión de pedidos con arquitectura de microservicios orientada a eventos — proyecto de aprendizaje Sr Backend (Node, TypeScript, Express, PostgreSQL, Redis, RabbitMQ, MongoDB)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "generate": "npm run generate --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
